{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackImg",
  "version": "1.1.0",
  "identifier": "com.gustavo.packimg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackImg - Empaquetado Inteligente de Imágenes",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "portable", "appimage", "deb", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2025 Gustavo Automatización",
    "category": "Graphics and Design",
    "shortDescription": "Empaquetado inteligente y eficiente de imágenes",
    "longDescription": "PackImg permite empaquetar múltiples imágenes en un lienzo de la manera más eficiente posible usando el algoritmo MaxRects. Ideal para crear atlases de texturas, spritesheets, o simplemente optimizar el espacio de almacenamiento.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "perUser",
        "allowToChangeInstallPath": true,
        "oneClick": false,
        "perMachine": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "PackImg",
        "displayLanguageSelector": false,
        "licenseFile": null
      },
      "portable": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {}
}