{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PackImg",
  "version": "1.0.0",
  "identifier": "com.gustavo.packimg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PackImg - Empaquetado Inteligente de Imágenes",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2025 Gustavo Automatización",
    "category": "Graphics",
    "shortDescription": "Empaquetado inteligente y eficiente de imágenes",
    "longDescription": "PackImg permite empaquetar múltiples imágenes en un lienzo de la manera más eficiente posible usando el algoritmo MaxRects. Ideal para crear atlases de texturas, spritesheets, o simplemente optimizar el espacio de almacenamiento.",
    "license": "MIT",
    "licenseFile": "",
    "windows": {
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null,
      "providerShortName": null
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "librsvg2-2"],
        "section": "graphics",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {}
}